#!/usr/bin/env bash
# Everything that has to pass before a change is trustworthy.
#
# There is no CI, deliberately: the tests that matter most depend on 40 GB of
# the user's photographs and on this machine's exiv2 build. See PLAN.md. This
# script is what stands in for it.
#
#   ./check            fmt, clippy, tests, tripwire
#   ./check coverage   the above plus an HTML coverage report
#   ./check fuzz       the above plus 30s on each fuzz target
#   ./check quick      skip the slow real-library tests
set -uo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.cargo/bin:$PATH"

LIBRARY=${NPC_TEST_LIBRARY:-$PWD/testdata}
MODE=${1:-all}
fail=0

step() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
ok()   { printf '   \033[32mok\033[0m  %s\n' "$1"; }
bad()  { printf '   \033[31mFAIL\033[0m  %s\n' "$1"; fail=1; }

step "formatting"
if cargo fmt --check >/dev/null 2>&1; then ok "rustfmt"; else
  bad "rustfmt (run: cargo fmt)"
fi

step "lints"
if cargo clippy --all-targets --quiet -- -D warnings 2>/tmp/clippy.log; then
  ok "clippy"
else
  bad "clippy"; grep -E '^(error|warning)' /tmp/clippy.log | head -15
fi

# Without the photographs the real-data tests are inert, and a sentinel test
# fails to say so. Report it here first, so the cause is obvious before the
# test output scrolls past. Quick mode never runs those tests, so it has
# nothing to report here -- CI, and a fresh clone before ./fetch-test-data,
# both run quick mode without the data present, and that isn't a failure.
if [ "$MODE" != quick ] && [ ! -d "$LIBRARY" ]; then
  printf '\n\033[1m== test photographs\033[0m\n'
  bad "not present at $LIBRARY"
  printf '         ./fetch-test-data          download them (98 MB, once)\n'
  printf '         NPC_TEST_LIBRARY=<path>    use a library you already have\n'
fi

step "tests"
# `release-nolto` profile (Cargo.toml): same opt-level as release -- real-library
# tests need that decode speed -- but no LTO, which release pays for at
# *link* time, once per test binary, on every single run regardless of how
# small the edit was. Worth nothing for a test binary about to be thrown
# away; only `cargo build --release` (the binary someone actually installs)
# wants it.
if [ "$MODE" = quick ]; then
  cargo test --profile release-nolto --lib --test invariant && ok "unit + invariant" || bad "tests"
else
  cargo test --profile release-nolto && ok "full suite" || bad "tests"
fi

# The tripwire: the library must be byte-identical after everything above.
# Scanning and thumbnailing are read-only operations, and this is what proves
# it rather than asserting it.
step "tripwire"
if [ -d "$LIBRARY" ]; then
  MANIFEST=.tripwire/library-stat.tsv
  mkdir -p .tripwire
  CURRENT=$(mktemp)
  # Only originals. Sidecars are ours and profiles are RawTherapee's; both
  # appear during normal use, and a tripwire that fires on legitimate activity
  # gets ignored, which defeats it. LC_ALL=C: a locale-aware sort ordered
  # `750_5744_1.NEF` differently from one session to the next and fired on
  # files that hadn't changed at all.
  find "$LIBRARY" -type f \! -name '*.xmp' \! -name '*.pp3' \
       -printf '%s\t%T@\t%p\n' | LC_ALL=C sort -k3 > "$CURRENT"
  if [ -f "$MANIFEST" ]; then
    if diff -q "$MANIFEST" "$CURRENT" >/dev/null; then
      ok "$(wc -l < "$CURRENT") originals unchanged"
    else
      bad "originals changed since the last run:"
      diff "$MANIFEST" "$CURRENT" | head -10 | sed 's/^/      /'
      echo "      (accept with: cp $CURRENT $MANIFEST)"
    fi
  else
    cp "$CURRENT" "$MANIFEST"
    ok "baseline recorded: $(wc -l < "$CURRENT") originals"
  fi
  rm -f "$CURRENT"
else
  printf '   skip  no test photographs at %s (run ./fetch-test-data)\n' "$LIBRARY"
fi

if [ "$MODE" = fuzz ]; then
  step "fuzzing"
  if command -v cargo-fuzz >/dev/null; then
    for t in query classify sidecar; do
      if cargo +nightly fuzz run "$t" -- -max_total_time=30 >/tmp/fuzz-$t.log 2>&1; then
        ok "$t (30s, no crashes)"
      else
        bad "$t"; tail -20 /tmp/fuzz-$t.log | sed 's/^/      /'
      fi
    done
  else
    bad "cargo-fuzz not installed (cargo install cargo-fuzz)"
  fi
fi

if [ "$MODE" = coverage ]; then
  step "coverage"
  if command -v cargo-llvm-cov >/dev/null; then
    cargo llvm-cov --release --html --output-dir target/coverage \
      --ignore-filename-regex '(main\.rs|tests/)' >/tmp/cov.log 2>&1
    cargo llvm-cov --release --summary-only \
      --ignore-filename-regex '(main\.rs|tests/)' 2>/dev/null | tail -25
    ok "report: target/coverage/html/index.html"
  else
    bad "cargo-llvm-cov not installed (cargo install cargo-llvm-cov)"
  fi
fi

printf '\n'
[ $fail -eq 0 ] && printf '\033[32mall good\033[0m\n' || printf '\033[31msomething failed\033[0m\n'
exit $fail
