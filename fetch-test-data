#!/usr/bin/env bash
# Fetch the test photographs.
#
# The suite runs against real camera files -- maker notes, preview pyramids and
# orientation tags are exactly what synthetic fixtures lack, and every one of
# those has caused a bug here. 98 MB of RAW is too much to keep in git, so it
# lives outside the repository and is fetched once.
#
#   ./fetch-test-data          download and extract into ./testdata
#   ./fetch-test-data --check  verify what is already there, download nothing
#
# Tests skip themselves if it is absent, so this is optional.
set -uo pipefail
cd "$(dirname "$0")"

URL="https://github.com/Try2Code/npc/releases/download/testdata-v1/npc-testdata.tar"
SHA256="27e89557b98916863c5aa15a33ecb3c3ecd0df754cb42a3199b4ca5433f54e5c"
DEST="testdata"
EXPECTED_FILES=11

have_data() { [ "$(find "$DEST" -type f 2>/dev/null | wc -l)" -eq "$EXPECTED_FILES" ]; }

if [ "${1:-}" = --check ]; then
  if have_data; then
    echo "ok    $DEST: $EXPECTED_FILES files, $(du -sh $DEST | cut -f1)"
    exit 0
  fi
  echo "missing  $DEST -- run ./fetch-test-data"
  exit 1
fi

if have_data; then
  echo "already present: $DEST ($(du -sh $DEST | cut -f1))"
  echo "delete it to re-fetch"
  exit 0
fi

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

echo "fetching 98 MB from GitHub ..."
if ! curl -fL --progress-bar --max-time 900 -o "$tmp/data.tar" "$URL"; then
  echo "download failed" >&2
  exit 1
fi

# Verified before extraction, not after: an archive is a directory traversal
# waiting to happen, and the checksum is the only thing that says this is the
# archive it claims to be.
got=$(sha256sum "$tmp/data.tar" | cut -d' ' -f1)
if [ "$got" != "$SHA256" ]; then
  echo "checksum mismatch -- refusing to extract" >&2
  echo "  expected $SHA256" >&2
  echo "  got      $got" >&2
  exit 1
fi

rm -rf "$DEST"
mkdir -p "$DEST"
tar xf "$tmp/data.tar" -C "$DEST"

n=$(find "$DEST" -type f | wc -l)
if [ "$n" -ne "$EXPECTED_FILES" ]; then
  echo "expected $EXPECTED_FILES files, extracted $n" >&2
  exit 1
fi

echo "extracted $n files into $DEST/ ($(du -sh $DEST | cut -f1))"
echo "run ./check to use them"
